{
  "name": "royal-sultan-mern",
  "version": "1.0.0",
  "description": "Royal Sultan Premium Basmati Rice - Fullstack MERN Application",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
